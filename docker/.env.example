# SignalOps backend environment
# Copy to .env (or docker/.env) and fill values. Never commit real secrets.

# Database (docker compose provides defaults)
DB_NAME=signalops
DB_USER=signalops
DB_PASSWORD=signalops
DB_PORT=5432
BACKEND_PORT=8080

# REQUIRED: base64 of at least 32 random bytes (256-bit HS256 secret).
# Generate with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (ISO-8601 durations)
ACCESS_TTL=PT15M
REFRESH_TTL=P7D

# Exact frontend origins allowed for credentialed CORS (comma-separated). No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set true when serving over HTTPS so the refresh cookie gets the Secure flag.
COOKIE_SECURE=false

# Demo seed data (never enable on a real database)
SEED_DEMO=true
SPRING_PROFILES_ACTIVE=local,demo
FRONTEND_PORT=3000